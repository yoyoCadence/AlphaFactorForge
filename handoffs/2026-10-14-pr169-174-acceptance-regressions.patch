diff --git a/alpha-factor-forge/e2e/acceptance-holdout-span.spec.ts b/alpha-factor-forge/e2e/acceptance-holdout-span.spec.ts
new file mode 100644
--- /dev/null
+++ b/alpha-factor-forge/e2e/acceptance-holdout-span.spec.ts
@@ -0,0 +1,25 @@
+import { test, expect } from '@playwright/test';
+
+test('short holdout column gets an annualization note even with a long full dataset', async ({ page }) => {
+  const start = Date.UTC(2024, 0, 1);
+  const candles = Array.from({ length: 600 }, (_, i) => {
+    const c = 100 + i * 0.05 + Math.sin(i / 7) * 2;
+    return { t: start + i * 86_400_000, o: c, h: c + 1, l: c - 1, c, v: 100 };
+  });
+  await page.goto('/?mock=1', { waitUntil: 'domcontentloaded' });
+  await page.locator('textarea').first().fill(JSON.stringify({ symbol: 'ACCEPTANCE', interval: '1d', candles }));
+  await page.getByRole('button', { name: '匯入 JSON', exact: true }).click();
+  await expect(page.getByTestId('run-backtest')).toBeEnabled();
+  await page.getByTestId('holdout-toggle').check();
+  await page.getByTestId('run-backtest').click();
+  await expect(page.getByTestId('col-樣本外')).toBeVisible();
+  const note = page.getByTestId('annualization-note');
+  const fullDays = (candles.at(-1)!.t - candles[0].t) / 86_400_000;
+  const split = Math.floor(candles.length * 0.7);
+  const outDays = (candles.at(-1)!.t - candles[split].t) / 86_400_000;
+  console.log(JSON.stringify({ fullDays, outDays, noteCount: await note.count(), metrics: await page.getByRole('table').first().innerText() }));
+  await page.getByTestId('popout-metrics').click();
+  await page.screenshot({ path: '../holdout-short-span.png' });
+  console.log(JSON.stringify({ expandedNoteCount: await page.getByTestId('metrics-popout').getByText(/不足一年/).count() }));
+  await expect(note).toBeVisible();
+});
diff --git a/alpha-factor-forge/e2e/acceptance-review-comments.spec.ts b/alpha-factor-forge/e2e/acceptance-review-comments.spec.ts
new file mode 100644
--- /dev/null
+++ b/alpha-factor-forge/e2e/acceptance-review-comments.spec.ts
@@ -0,0 +1,37 @@
+import { test, expect } from '@playwright/test';
+
+test('exactly 365 daily bars agrees with the engine one-year basis', async ({ page }) => {
+  const start = Date.UTC(2024, 0, 1);
+  const candles = Array.from({ length: 365 }, (_, i) => {
+    const c = 100 + i * 0.05 + Math.sin(i / 7) * 2;
+    return { t: start + i * 86_400_000, o: c, h: c + 1, l: c - 1, c, v: 100 };
+  });
+  await page.goto('/?mock=1', { waitUntil: 'domcontentloaded' });
+  await page.locator('textarea').first().fill(JSON.stringify({ symbol: 'YEAR-BOUNDARY', interval: '1d', candles }));
+  await page.getByRole('button', { name: '匯入 JSON', exact: true }).click();
+  await expect(page.getByTestId('run-backtest')).toBeEnabled();
+  await page.getByTestId('run-backtest').click();
+  await expect(page.getByTestId('save-result')).toBeVisible();
+  console.log(JSON.stringify({ engineYears: 365 / 365, timestampDays: (candles.at(-1)!.t - candles[0].t) / 86_400_000, note: await page.getByTestId('annualization-note').textContent() }));
+  await page.screenshot({ path: '../exact-year-warning.png' });
+  await expect(page.getByTestId('annualization-note')).toHaveCount(0);
+});
+
+test('a repeated identical notice restarts its eight-second lifetime', async ({ page }) => {
+  await page.clock.install();
+  await page.goto('/?mock=1', { waitUntil: 'domcontentloaded' });
+  await page.getByTestId('load-sample').click();
+  await page.getByTestId('sweep-toggle').click();
+  await page.getByTestId('run-sweep').click();
+  await expect(page.getByTestId('sweep-cell-7')).toBeVisible();
+  await page.getByTestId('sweep-cell-7').click();
+  const applied = page.getByText('已套用：快線MA=7');
+  await expect(applied).toBeVisible();
+  await page.clock.fastForward(7000);
+  await expect(applied).toBeVisible();
+  await page.getByTestId('sweep-cell-7').click();
+  await expect(applied).toBeVisible();
+  await page.clock.fastForward(2000);
+  console.log(JSON.stringify({ noticeCountTwoSecondsAfterRepeat: await applied.count() }));
+  await expect(applied).toBeVisible();
+});
