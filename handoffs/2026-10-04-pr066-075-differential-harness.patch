+// TEMPORARY (PR acceptance review): random TS-reference cases for a Rust
+// differential run. Not committed.
+import { writeFileSync } from 'node:fs';
+import { runBacktest, type BacktestConfig } from '../src/core/backtest';
+import { encodeMetricsForParity } from '../src/parity/parityEncode';
+
+function mulberry32(seed: number) {
+  return () => {
+    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+const rnd = mulberry32(Number(process.env.SEED ?? 20261004));
+const pick = <T,>(xs: T[]): T => xs[Math.floor(rnd() * xs.length)];
+const N = Number(process.env.CASES ?? 600);
+const cases: unknown[] = [];
+const errors: unknown[] = [];
+let skipped = 0;
+for (let k = 0; k < N; k++) {
+  const n = pick([2, 3, 5, 10, 40, 120, 300]);
+  const step = pick([3_600_000, 86_400_000]);
+  const t0 = Date.UTC(2024, pick([0, 1, 5, 11]), pick([1, 15, 28]), 0, 0, 0);
+  let price = pick([0.5, 20, 100, 30_000]);
+  const candles = [];
+  for (let i = 0; i < n; i++) {
+    const gap = rnd() < 0.1 ? (rnd() - 0.5) * 0.2 : 0;
+    const open = i === 0 ? price : price * (1 + gap);
+    const close = open * (1 + (rnd() - 0.5) * 0.06);
+    const high = Math.max(open, close) * (1 + rnd() * 0.03);
+    const low = Math.min(open, close) * (1 - rnd() * 0.03);
+    candles.push({ timestamp: t0 + i * step, open, high, low, close, volume: Math.round(rnd() * 1000) });
+    price = close;
+  }
+  const p = pick([0.05, 0.2, 0.5]);
+  const signals = {
+    entry: Array.from({ length: n }, () => rnd() < p),
+    exit: Array.from({ length: n }, () => rnd() < p),
+  };
+  const config: BacktestConfig = {
+    exec: {
+      direction: pick(['long', 'short', 'both'] as const),
+      sizingPct: pick([1, 1, 0.5, 0.25, 0.001, 0]),
+      fillMode: pick(['close', 'nextOpen'] as const),
+    },
+    cost: { feePct: pick([0, 0.0005, 0.001, 0.01]), slippagePct: pick([0, 0.0002, 0.002]) },
+    barsPerYear: pick([8760, 365, 252]),
+  };
+  if (rnd() < 0.5) {
+    const risk: NonNullable<BacktestConfig['risk']> = {};
+    if (rnd() < 0.7) risk.stopLossPct = pick([0.005, 0.02, 0.1]);
+    if (rnd() < 0.7) risk.takeProfitPct = pick([0.005, 0.03, 0.2]);
+    config.risk = risk;
+  }
+  if (rnd() < 0.3) config.startEquity = pick([1, 1000, 123456.78]);
+  if (rnd() < 0.25 && n > 2) {
+    const a = Math.floor(rnd() * n), b = Math.floor(rnd() * n);
+    config.from = Math.min(a, b); config.to = Math.max(a, b);
+  }
+  const core = candles.map((c) => ({ t: c.timestamp, o: c.open, h: c.high, l: c.low, c: c.close, v: c.volume }));
+  try {
+    const result = runBacktest(core, signals, config);
+    const finite = result.trades.every((t) => [t.entryPrice, t.exitPrice, t.pnl, t.pnlPct].every(Number.isFinite))
+      && result.equity.every((e) => Number.isFinite(e.equity));
+    if (!finite) { skipped++; continue; }
+    cases.push({ id: `rand-${k}`, input: { candles, signals, config }, expected: {
+      trades: result.trades, equity: result.equity, metrics: encodeMetricsForParity(result.metrics) } });
+  } catch (error) {
+    errors.push({ id: `rand-err-${k}`, input: { candles, signals, config }, expectedErrorIncludes: '' , message: String(error) });
+  }
+}
+writeFileSync(process.env.OUT!, JSON.stringify({ cases, errorCases: errors }));
+console.log(`cases=${cases.length} errors=${errors.length} skippedNonFinite=${skipped}`);
