@@ -0,0 +1,156 @@
+// TEMPORARY (PR acceptance review): Rust engine vs random TS-reference cases.
+use serde::Deserialize;
+
+use super::backtest::{run_backtest, BacktestConfig, Signals};
+use super::parity_support::{
+    assert_equity, assert_metrics, assert_trades, ExpectedEquity, ExpectedMetrics, ExpectedTrade,
+    NumericTolerance,
+};
+use super::types::Candle;
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Fixture {
+    cases: Vec<ParityCase>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ParityCase {
+    id: String,
+    input: CaseInput,
+    expected: ExpectedOutput,
+}
+
+#[derive(Debug, Deserialize)]
+struct CaseInput {
+    candles: Vec<Candle>,
+    signals: Signals,
+    config: BacktestConfig,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ExpectedOutput {
+    trades: Vec<ExpectedTrade>,
+    equity: Vec<ExpectedEquity>,
+    metrics: ExpectedMetrics,
+}
+
+#[test]
+fn review_rust_backtest_matches_random_typescript_cases() {
+    let Ok(path) = std::env::var("AFF_REVIEW_DIFF_JSON") else {
+        return;
+    };
+    let fixture: Fixture =
+        serde_json::from_str(&std::fs::read_to_string(path).unwrap()).expect("parse");
+    let tolerance = NumericTolerance { absolute: 1e-12, relative: 1e-10 };
+    let mut failures = Vec::new();
+    std::panic::set_hook(Box::new(|_| {}));
+    for case in &fixture.cases {
+        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let result = run_backtest(&case.input.candles, &case.input.signals, &case.input.config)
+                .unwrap_or_else(|error| panic!("{}: engine failed: {error}", case.id));
+            assert_trades(&case.id, &result.trades, &case.expected.trades, tolerance);
+            assert_equity(&case.id, &result.equity, &case.expected.equity, tolerance);
+            assert_metrics(&case.id, &result.metrics, &case.expected.metrics, tolerance);
+        }));
+        if let Err(payload) = outcome {
+            let message = payload
+                .downcast_ref::<String>()
+                .cloned()
+                .or_else(|| payload.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_default();
+            failures.push(format!("{}: {}", case.id, message.lines().next().unwrap_or("")));
+        }
+    }
+    let _ = std::panic::take_hook();
+    println!("checked {} cases, {} differ", fixture.cases.len(), failures.len());
+    for failure in failures.iter().take(25) {
+        println!("  {failure}");
+    }
+    assert!(failures.is_empty());
+}
+
+// ---- indicators
+use super::indicators::{atr, bbands, ema, highest, lowest, macd, roc, rsi, sma, stddev, true_range, wma};
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct IndFixture {
+    cases: Vec<IndCase>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct IndPrm {
+    sma: usize, ema: usize, wma: usize, rsi: usize, macd_fast: usize, macd_slow: usize,
+    macd_signal: usize, atr: usize, bb: usize, bb_mult: f64, sd: usize, ext: usize, roc: usize,
+}
+
+#[derive(Debug, Deserialize)]
+struct IndCase {
+    id: String,
+    close: Vec<String>,
+    high: Vec<String>,
+    low: Vec<String>,
+    prm: IndPrm,
+    expected: std::collections::BTreeMap<String, Vec<serde_json::Value>>,
+}
+
+fn same(actual: f64, expected: &serde_json::Value) -> bool {
+    match expected {
+        serde_json::Value::String(s) => match s.as_str() {
+            "NaN" => actual.is_nan(),
+            "Infinity" => actual == f64::INFINITY,
+            "-Infinity" => actual == f64::NEG_INFINITY,
+            _ => false,
+        },
+        serde_json::Value::Number(n) => {
+            let e = n.as_f64().unwrap();
+            if !actual.is_finite() { return false; }
+            let d = (actual - e).abs();
+            d <= 1e-12 || d <= 1e-10 * actual.abs().max(e.abs())
+        }
+        _ => false,
+    }
+}
+
+#[test]
+fn review_rust_indicators_match_random_typescript_cases() {
+    let Ok(path) = std::env::var("AFF_REVIEW_DIFF_IND_JSON") else { return; };
+    let fixture: IndFixture = serde_json::from_str(&std::fs::read_to_string(path).unwrap()).unwrap();
+    let mut failures: Vec<String> = Vec::new();
+    let mut by_series: std::collections::BTreeMap<String, usize> = Default::default();
+    let de = |xs: &[String]| -> Vec<f64> { xs.iter().map(|h| f64::from_bits(u64::from_str_radix(h, 16).unwrap())).collect() };
+    for case in &fixture.cases {
+        let p = &case.prm;
+        let (close, high, low) = (de(&case.close), de(&case.high), de(&case.low));
+        let m = macd(&close, p.macd_fast, p.macd_slow, p.macd_signal);
+        let b = bbands(&close, p.bb, p.bb_mult);
+        let actual: Vec<(&str, Vec<f64>)> = vec![
+            ("sma", sma(&close, p.sma)), ("ema", ema(&close, p.ema)),
+            ("wma", wma(&close, p.wma)), ("rsi", rsi(&close, p.rsi)),
+            ("macd", m.macd), ("macdSignal", m.signal), ("macdHist", m.hist),
+            ("trueRange", true_range(&high, &low, &close).unwrap()),
+            ("atr", atr(&high, &low, &close, p.atr).unwrap()),
+            ("bbMiddle", b.middle), ("bbUpper", b.upper), ("bbLower", b.lower),
+            ("stddev", stddev(&close, p.sd)), ("highest", highest(&close, p.ext)),
+            ("lowest", lowest(&close, p.ext)), ("roc", roc(&close, p.roc)),
+        ];
+        for (name, series) in actual {
+            let expected = &case.expected[name];
+            let detail = match (series.len() != expected.len(), series.iter().zip(expected).position(|(a, e)| !same(*a, e))) {
+                (true, _) => Some(format!("length {} vs {}", series.len(), expected.len())),
+                (false, Some(i)) => Some(format!("[{i}] rust={} ts={}", series[i], expected[i])),
+                _ => None,
+            };
+            if let Some(detail) = detail {
+                *by_series.entry(name.to_string()).or_default() += 1;
+                failures.push(format!("{} {name} (n={}, prm={:?}): {detail}", case.id, close.len(), p));
+            }
+        }
+    }
+    println!("checked {} indicator cases, {} series differ, by series {:?}", fixture.cases.len(), failures.len(), by_series);
+    for failure in failures.iter().take(20) { println!("  {failure}"); }
+    assert!(failures.is_empty());
+}
