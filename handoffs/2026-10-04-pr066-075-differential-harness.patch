@@ -0,0 +1,35 @@
+// TEMPORARY (PR acceptance review): random TS-reference indicator cases.
+import { writeFileSync } from 'node:fs';
+import { sma, ema, wma, rsi, macd, trueRange, atr, bbands, stddev, highest, lowest, roc } from '../src/core/indicators';
+
+function mulberry32(seed: number) {
+  return () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
+}
+const rnd = mulberry32(Number(process.env.SEED ?? 11));
+const pick = <T,>(xs: T[]): T => xs[Math.floor(rnd() * xs.length)];
+const bits = (xs: number[]) => xs.map((x) => { const b = Buffer.alloc(8); b.writeDoubleBE(x); return b.toString("hex"); });
+const enc = (xs: number[]) => xs.map((x) => (Number.isFinite(x) ? x : String(x)));
+const cases = [];
+for (let k = 0; k < Number(process.env.CASES ?? 800); k++) {
+  const n = pick([1, 2, 3, 5, 8, 15, 30, 60, 200]);
+  let p = pick([0.001, 1, 100, 50000]);
+  const close: number[] = [], high: number[] = [], low: number[] = [];
+  const flat = rnd() < 0.3;
+  for (let i = 0; i < n; i++) {
+    if (!(flat && rnd() < 0.6)) p = p * (1 + (rnd() - 0.5) * pick([0, 0.02, 0.2]));
+    close.push(p); high.push(p * (1 + rnd() * 0.01)); low.push(p * (1 - rnd() * 0.01));
+  }
+  const per = () => pick([1, 2, 3, 5, 7, 14, 20, 26, 50, 250]);
+  const prm = { sma: per(), ema: per(), wma: per(), rsi: per(), macdFast: per(), macdSlow: per(), macdSignal: per(),
+    atr: per(), bb: per(), bbMult: pick([0.5, 2, 3]), sd: per(), ext: per(), roc: per() };
+  const m = macd(close, prm.macdFast, prm.macdSlow, prm.macdSignal);
+  const b = bbands(close, prm.bb, prm.bbMult);
+  cases.push({ id: `ind-${k}`, close: bits(close), high: bits(high), low: bits(low), prm, expected: {
+    sma: enc(sma(close, prm.sma)), ema: enc(ema(close, prm.ema)), wma: enc(wma(close, prm.wma)), rsi: enc(rsi(close, prm.rsi)),
+    macd: enc(m.macd), macdSignal: enc(m.signal), macdHist: enc(m.hist), trueRange: enc(trueRange(high, low, close)),
+    atr: enc(atr(high, low, close, prm.atr)), bbMiddle: enc(b.middle), bbUpper: enc(b.upper), bbLower: enc(b.lower),
+    stddev: enc(stddev(close, prm.sd)), highest: enc(highest(close, prm.ext)), lowest: enc(lowest(close, prm.ext)), roc: enc(roc(close, prm.roc)) } });
+}
+writeFileSync(process.env.OUT!, JSON.stringify({ cases }));
+console.log(`cases=${cases.length}`);
